{
    "name": "mehul0810/updatesync",
    "description": "UpdateSync adds GitHub release updates to WordPress plugins.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.5",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.4",
        "phpstan/phpstan": "^2.1",
        "php-stubs/wordpress-stubs": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "UpdateSync\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Mehul Gohil",
            "email": "hello@mehulgohil.com"
        }
    ],
    "homepage": "https://github.com/mehul0810/updatesync",
    "scripts": {
        "phpcs": "vendor/bin/phpcs --standard=phpcs.ruleset.xml src/",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --debug --memory-limit=512M"
    },
    "extra": {
        "phpcodesniffer": {
            "installed_paths": [
                "vendor/wp-coding-standards/wpcs"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
